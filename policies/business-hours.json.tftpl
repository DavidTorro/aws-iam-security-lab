{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyBeforeOpening",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${window_start}"
        }
      }
    },
    {
      "Sid": "DenyAfterClosing",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "DateGreaterThan": {
          "aws:CurrentTime": "${window_end}"
        }
      }
    }
  ]
}
